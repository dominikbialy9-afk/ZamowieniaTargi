# Skopiuj ten plik do `.env` i uzupełnij własnymi danymi.

# --- Dostęp do Airtable ---
AIRTABLE_TOKEN=patXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appDg7Emi7rYsjFZ2
AIRTABLE_TABLE_NAME=Tabela Targi
AIRTABLE_PRODUCTS_TABLE_NAME=Produkty

# --- Konfiguracja logowania Microsoft (Azure AD) ---
AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_SECRET=change-me
AZURE_AD_REDIRECT_URI=http://localhost:4300/auth/callback
AZURE_AD_SCOPES=openid profile email offline_access

# --- Sesje i ograniczenia dostępu ---
ALLOWED_EMAIL_DOMAIN=warsawexpo.eu
SESSION_SECRET=change-me-min-32-chars
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_NAME=zt_session
SESSION_SAMESITE=Lax
SESSION_SECURE_COOKIES=false

# --- Tryb demonstracyjny i port serwera ---
DEMO_MODE=true
PORT=4300
